@echo off
title Lab Setup - VirtualBox Mass Installer
echo ===================================================
echo   Installing Microsoft Visual C++ Redistributable
echo   (Installing silently in the background...)
echo ===================================================

:: /install /quiet /norestart forces it to install with no popups and blocks it from restarting the PC
start /wait "" "%~dp0vc_redist.x64.exe" /install /quiet /norestart

echo.
echo C++ Package Installed Successfully!
echo.
echo ===================================================
echo   Installing Oracle VirtualBox 7.2.22
echo   (This will take 1-2 minutes. Please wait...)
echo ===================================================

:: --silent installs VirtualBox with no GUI or popups
start /wait "" "%~dp0VirtualBox-7.2.22-Win.exe" --silent --ignore-reboot

echo.
echo VirtualBox is now installed!
echo ===================================================
pause
